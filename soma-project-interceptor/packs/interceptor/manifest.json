  "policies": [
    {
      "policy_id": "interceptor.iff_gate",
      "description": "Never engage without positive hostile identification. Abort immediately if IFF returns friendly or uncertain.",
      "scope": "engagement.*",
      "rule": "require iff.hostile == true before any engagement skill",
      "enforcement": "hard_block"
    },
    {
      "policy_id": "interceptor.altitude_floor",
      "description": "Never descend below minimum safe altitude except during terminal phase with confirmed target lock.",
      "scope": "navigation.set_altitude",
      "rule": "altitude >= MIN_SAFE_ALT unless engagement.armed == true AND target.lock == true",
      "enforcement": "hard_block"
    },
    {
      "policy_id": "interceptor.geofence",
      "description": "Never leave designated engagement zone. Abort and return if approaching boundary.",
      "scope": "navigation.*",
      "rule": "position within geofence_polygon",
      "enforcement": "hard_block"
    }
